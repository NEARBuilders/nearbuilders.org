# Generated test environment — loaded by test suites instead of .env
# Test databases run on in-memory pglite — no docker involved

# app.api
API_DATABASE_URL=pglite::memory:
BETTER_AUTH_SECRET=regression-test-secret-do-not-use-in-production

# app.auth
AUTH_DATABASE_URL=pglite::memory:

# plugins.projects
PROJECTS_DATABASE_URL=pglite::memory:

# plugins.builders
BUILDERS_DATABASE_URL=pglite::memory:

# plugins.events
EVENTS_DATABASE_URL=pglite::memory:

# plugins.proposals
PROPOSALS_DATABASE_URL=pglite::memory:

# plugins.votes
VOTES_DATABASE_URL=pglite::memory:

# plugins.bookmarks
BOOKMARKS_DATABASE_URL=pglite::memory:

# plugins.notifications
NOTIFICATIONS_DATABASE_URL=pglite::memory:

# plugins.activity
ACTIVITY_DATABASE_URL=pglite::memory:

# plugins.nearcatalog
NEARCATALOG_DATABASE_URL=pglite::memory:

# plugins.credits
CREDITS_DATABASE_URL=pglite::memory:

# plugins.storage
STORAGE_DATABASE_URL=pglite::memory:

