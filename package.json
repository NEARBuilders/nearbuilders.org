{
  "name": "monorepo",
  "private": true,
  "scripts": {
    "dev": "bos dev",
    "dev:ui": "bos dev --ui local --api remote",
    "dev:api": "bos dev --ui remote --api local",
    "dev:proxy": "bos dev --proxy",
    "build": "bos build",
    "deploy": "bos build --deploy",
    "publish": "bos publish",
    "bos": "bos",
    "types:gen": "bos types gen",
    "typecheck": "pnpm run types:gen && if [ -d ui ]; then pnpm --dir ui run typecheck || exit 1; fi && if [ -d api ]; then pnpm --dir api run typecheck || exit 1; fi && for dir in plugins/*; do if [ -f \"$dir/package.json\" ]; then pnpm --dir \"$dir\" run typecheck || exit 1; fi; done",
    "lint": "biome check . && pnpm --dir ui lint",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "start": "bos start",
    "changeset": "changeset",
    "postinstall": "bos types gen || true",
    "version": "changeset version",
    "release": "echo 'Packages versioned - app release handled by workflow'",
    "db:push": "pnpm --dir api drizzle-kit push",
    "db:studio": "bos db:studio",
    "db:generate": "pnpm --dir api drizzle-kit generate",
    "db:migrate": "pnpm --dir api drizzle-kit migrate",
    "test": "pnpm --dir api --if-present run test || exit 1 && pnpm --dir ui --if-present run test || exit 1 && [ -d plugins ] && for d in plugins/*; do if [ -f \"$d/package.json\" ]; then pnpm --dir \"$d\" --if-present run test || exit 1; fi; done || true",
    "test:api": "pnpm --dir api test",
    "test:integration": "pnpm --dir api test tests/integration/",
    "dev:postgres": "docker compose up -d --wait && pnpm run dev",
    "dev:postgres:down": "docker compose down",
    "dev:postgres:reset": "docker compose down -v && docker compose up -d --wait",
    "db:doctor": "bos db:doctor",
    "db:repair": "bos db:repair",
    "regression:start:dev": "BOS_NO_PERSIST_PORTS=1 bun packages/everything-dev/src/cli.ts dev --no-interactive --port 4100 --api-port 4101 --auth-port 4102 --ui-port 4103 --plugin-port-start 4110",
    "regression:start:prod": "BOS_NO_PERSIST_PORTS=1 PORT=4100 bun ./node_modules/everything-dev/dist/cli.mjs start --no-interactive",
    "test:regression:http:dev": "REGRESSION_MODE=dev sh -lc 'cd tests/regression/http && go test ./... -count=1 -v -timeout 10m'",
    "test:regression:http:prod": "REGRESSION_MODE=prod sh -lc 'cd tests/regression/http && go test ./... -count=1 -v -timeout 10m'",
    "test:regression:browser:install": "bunx playwright install --with-deps chromium",
    "test:regression:browser:dev": "REGRESSION_MODE=dev bunx playwright test -c tests/regression/browser/playwright.config.mjs --project=dev",
    "test:regression:browser:prod": "REGRESSION_MODE=prod bunx playwright test -c tests/regression/browser/playwright.config.mjs --project=prod",
    "test:regression:dev": "pnpm run test:regression:http:dev && pnpm run test:regression:browser:dev",
    "test:regression:prod": "pnpm run test:regression:http:prod && pnpm run test:regression:browser:prod",
    "test:regression": "pnpm run test:regression:dev"
  },
  "packageManager": "pnpm@12.10.1",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@changesets/cli": "^2.29.8",
    "@types/bun": "latest",
    "dotenv": "^17.3.1",
    "tsx": "^4.21.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "catalog:",
    "@types/pg": "catalog:",
    "@playwright/test": "^1.58.1"
  },
  "dependencies": {
    "@better-auth/api-key": "catalog:",
    "@better-auth/core": "catalog:",
    "@better-auth/passkey": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@libsql/client": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/server": "catalog:",
    "@types/node": "catalog:",
    "better-auth": "catalog:",
    "better-near-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "every-plugin": "catalog:",
    "everything-dev": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=20.19"
  }
}
