# FRAMEWORK-OWNED — reconciled from the parent template by `bos upgrade`.
# Local edits are allowed: on the next upgrade the template version wins and your
# copy is backed up under `.bos/sync-backup/`. To make a change permanent, file an
# issue: https://github.com/NEARBuilders/everything-dev/issues

# Generated from configured bos secrets
# Update values as needed for your local environment

# app.host
CORS_ORIGIN=http://localhost:3000

# app.api
# Leave empty to run dev on ephemeral pglite; set a postgres:// URL to opt into compose Postgres.
API_DATABASE_URL=
BETTER_AUTH_SECRET=
NEARAI_API_KEY=
NEARAI_MODEL=
GITHUB_TOKEN=
REQUIRE_ADMIN_APPROVAL=

# app.auth
# Leave empty to run dev on ephemeral pglite; set a postgres:// URL to opt into compose Postgres.
AUTH_DATABASE_URL=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_SECRET=
FASTNEAR_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
RESEND_API_KEY=

# plugins.builders
NOMINATION_TOKEN_SECRET=

# plugins.events
LUMA_CALENDAR_API_KEYS=

# plugins.activity
ACTIVITY_GATEWAY_URL=
ACTIVITY_GATEWAY_API_KEY=
ACTIVITY_SOURCE_ID=

# plugins.nearcatalog
# Sending approved listings to NEAR Catalog's API. Both empty keeps sending off.
# See plugins/nearcatalog/README.md.
NEARCATALOG_SUBMIT_URL=
NEARCATALOG_SUBMIT_TOKEN=

# plugins.credits
CREDITS_ENABLED=
CREDITS_AMOUNT_USD=
CREDITS_CLAIMS_CLOSE_AT=
CREDITS_KEY_EXPIRES_AT=
NEARAI_CREDITS_REFRESH_TOKEN=
NEARAI_CREDITS_USER_AGENT=
NEARAI_CREDITS_WORKSPACE_ID=

# plugins.nostr
BUZZ_NSEC=

