# FRAMEWORK-OWNED — reconciled from the parent template by `bos upgrade`.
# Local edits are allowed: on the next upgrade the template version wins and your
# copy is backed up under `.bos/sync-backup/`. To make a change permanent, file an
# issue: https://github.com/NEARBuilders/everything-dev/issues

# Generated from configured bos secrets
# Update values as needed for your local environment

# app.host
CORS_ORIGIN=http://localhost:3000

# app.api
# Leave empty to run dev on ephemeral pglite; set a postgres:// URL to opt into compose Postgres.
API_DATABASE_URL=
BETTER_AUTH_SECRET=
NEARAI_API_KEY=
NEARAI_MODEL=
GITHUB_TOKEN=
REQUIRE_ADMIN_APPROVAL=

# app.auth
# Leave empty to run dev on ephemeral pglite; set a postgres:// URL to opt into compose Postgres.
AUTH_DATABASE_URL=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_SECRET=
FASTNEAR_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
RESEND_API_KEY=

# plugins.builders
NOMINATION_TOKEN_SECRET=

# plugins.events
LUMA_CALENDAR_API_KEYS=

# plugins.activity
ACTIVITY_GATEWAY_URL=
ACTIVITY_GATEWAY_API_KEY=
ACTIVITY_SOURCE_ID=

# plugins.nostr
BUZZ_NSEC=

# plugins.storage
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_PUBLIC_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

